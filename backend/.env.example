# Copy to backend/.env (or configure the same values in your environment).
# Do not commit the real .env file.
DB_PASSWORD=change-me
DB_USER=root
DB_HOST=127.0.0.1
DB_NAME=yhoc_corpus
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
PDF_LLM_PROVIDER=gemini
PDF_LLM_MODEL=gemini-flash-lite-latest
PDF_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
PDF_LLM_TEMPERATURE=0
PDF_LLM_TIMEOUT_SECONDS=90
PDF_LLM_MAX_RETRIES=2
PDF_LLM_MAX_INPUT_CHARS=90000
PDF_EXTRACTION_PROMPT_VERSION=1.1
AUTH_SESSION_HOURS=12

# Vietnamese-only corpus gate. Comma-separated OJS domains accepted by /api/scrape.
CORPUS_ALLOWED_JOURNAL_DOMAINS=tapchinghiencuuyhoc.vn,tapchiyhcd.vn,tapchiyhocvietnam.vn
CORPUS_LANGUAGE_METADATA_MIN_CHARS=80
CORPUS_LANGUAGE_PDF_MIN_CHARS=400
CORPUS_LANGUAGE_CHUNK_CHARS=1200
CORPUS_LANGUAGE_MIN_VI_RATIO=0.72
CORPUS_LANGUAGE_EN_REJECT_RATIO=0.65

# Storage paths. Relative paths are resolved from backend/.
CORPUS_PDF_CANDIDATES_DIR=Văn_Bản_Y_Tế_PDF/candidates
CORPUS_PDF_QUARANTINE_DIR=Văn_Bản_Y_Tế_PDF/quarantine
CORPUS_LANGUAGE_AUDIT_REPORT_DIR=reports
PDF_EXTRACT_OUTPUT_DIR=Kho_Ngu_Lieu_Txt/pdf_extracted

# Tâm Anh Q&A crawler.
CRAWLER_TAMANH_BASE_URL=https://tamanhhospital.vn/
CRAWLER_TAMANH_MAX_RETRIES=3
CRAWLER_TAMANH_REQUEST_DELAY_MS=1000
CRAWLER_TAMANH_TIMEOUT_MS=15000
CRAWLER_TAMANH_OUTPUT_DIR=Kho_Ngu_Lieu_Txt/tamanh
